{
  "manifest_version": 3,
  "name": "Gif Me A Sec: GIF Webcam for Google Meet & Zoom",
  "short_name": "Gif Me A Sec",
  "version": "1.0.3",
  "description": "Show a reaction GIF on your webcam in Google Meet, Zoom, Teams and Discord for a few seconds. Free, no virtual camera.",
  "homepage_url": "https://github.com/ereneld/gif-me-a-sec",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "scripting"
  ],
  "optional_host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "options_page": "popup/popup.html",
  "commands": {
    "replay-gif": {
      "suggested_key": {
        "default": "Alt+Shift+G"
      },
      "description": "Replay the GIF on the current tab"
    },
    "toggle-gifcam": {
      "suggested_key": {
        "default": "Alt+Shift+C"
      },
      "description": "Turn Gif Me A Sec on or off"
    },
    "toggle-panel": {
      "suggested_key": {
        "default": "Alt+Shift+Q"
      },
      "description": "Show or hide the GIF quick panel on this page"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "panel/panel.html"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
